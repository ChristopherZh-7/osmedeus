# The Dockerfile does `COPY . .`, so everything here is build context. The Go
# build needs no JS tooling, and platform/ can hold a ~600MB node_modules tree
# once anyone runs `bun install`. Keep sub-projects out except the small workflow
# collection, which the production image copies after preset installation so a
# source checkout and its one-command deployment always use the same workflows.
#
# public/ui/ is the *built* dashboard and IS needed: it is go:embed'd.
platform/*
!platform/golish-workflow/
!platform/golish-workflow/**

.git/
.github/

# Build outputs and local artifacts
build/bin/
build/dist-npm/
bin/
coverage.out
coverage.html
test-results.xml

# Databases and scan artifacts
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Editor / OS noise
.DS_Store
.idea/
.vscode/
.claude/
.agents/
