{
  "name": "@golish/agent-harness-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Versioned DeepSeek Harness sidecar for the Golish pentest platform",
  "type": "module",
  "scripts": {
    "start": "node ./scripts/start.mjs",
    "test": "node --test ./plugins/dsh-pentagi-orchestrator/lib/*.test.js ./scripts/*.test.mjs",
