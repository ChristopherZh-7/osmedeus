    "verify:install": "node ./scripts/verify-install.mjs",
    "upgrade:dsh": "node ./scripts/upgrade.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@golish/dsh-plugin": "file:plugins/dsh-golish-plugin",
    "@golish/dsh-pentagi-orchestrator": "file:plugins/dsh-pentagi-orchestrator"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
