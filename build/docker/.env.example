# Golish Production Environment Variables
# ==========================================
# `make deploy` generates a private .golish-deploy/.env automatically.
# This file remains as a reference for operators who run Compose manually.
#
# IMPORTANT: Never commit .env to version control!

# =============================================================================
# PostgreSQL Configuration
# =============================================================================
# Database credentials - MUST be changed for production
POSTGRES_USER=golish
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=golish

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
# Uncomment and set if you want Redis authentication
# REDIS_PASSWORD=your_secure_redis_password_here

# =============================================================================
# Server Configuration
# =============================================================================
# External port for the API server
GOLISH_SERVER_PORT=8002

# Timezone for logs and timestamps
TZ=UTC

# =============================================================================
# Worker Configuration
# =============================================================================
# Number of worker replicas for distributed scanning
WORKER_REPLICAS=2

# Optional model credential used by the private DSH runtime
DEEPSEEK_API_KEY=

# =============================================================================
# IMPORTANT NOTES
# =============================================================================
# 1. Prefer `make deploy`; it keeps PostgreSQL and generated settings aligned.
#
# 2. Generate secure passwords with:
#    openssl rand -base64 24
#
# 3. Generate JWT secret (for golish-settings.production.yaml) with:
#    openssl rand -base64 32
#
# 4. If using REDIS_PASSWORD, update golish-settings.production.yaml:
#    redis.password: "your_redis_password"
