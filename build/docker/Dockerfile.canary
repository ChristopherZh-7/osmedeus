# Golish Canary Test Dockerfile
# Multi-stage build that compiles from source and layers onto the toolbox image,
# ensuring canary tests exercise the CURRENT source code, not the last release.

# ── Stage 1: build from source ──────────────────────────────────────────────
FROM golang:1.26-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /golish ./cmd/golish

# ── Stage 2: runtime (mirrors Dockerfile.toolbox) ───────────────────────────
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    curl \
    wget \
    git \
    unzip \
    jq \
    bash \
    xz-utils \
    python3 \
    python3-pip \
    python3-venv \
    chromium-browser \
    sudo \
    golang-go \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf /usr/bin/python3 /usr/bin/python

ENV PATH="/root/go/bin:${PATH}"
ENV GOPATH="/root/go"

RUN mkdir -p /root/golish-base /root/workspaces-golish /root/go/bin

WORKDIR /root

# Copy the source-built binary first so install commands can use it
COPY --from=builder /golish /root/.local/bin/golish
COPY --from=builder /golish /root/go/bin/golish

ENV PATH="/root/.local/bin:/root/go/bin:/root/golish-base/external-binaries:${PATH}"

# Install base workflows, tools, etc.
RUN golish install base --preset

# This is for sast test
RUN golish install binary --name trivy --name semgrep --name kingfisher --name bearer

# This is for general test (probe-dns, recon-http-fp, scan-content)
RUN golish install binary --name dnsx --name httpx --name puredns --name massdns --name ffuf

# Copy the canary entrypoint
COPY build/docker/canary-entrypoint.sh /usr/local/bin/canary-entrypoint.sh
RUN chmod +x /usr/local/bin/canary-entrypoint.sh

# Verify the source-built binary works
RUN golish health

EXPOSE 8002

ENTRYPOINT ["/usr/local/bin/canary-entrypoint.sh"]
